{
  // Copy this file to %APPDATA%\SecondSight\config.json and fill it in.
  // Never commit your real config: it holds the bot's password.

  // The bot account's username.
  "Username": "DexterFrost",

  // The bot's password. You can leave this out and set the
  // SECONDSIGHT_PASSWORD environment variable instead.
  "Password": "",

  // The only avatar the bot takes direction from. A name or a UUID.
  "Owner": "Jimmi Tiponi",

  // Where to log in: "last", "home", or "Region Name/x/y/z".
  "StartLocation": "last",

  // Log in as soon as Claude starts the MCP server.
  "AutoLogin": false,

  // The bot's own limits on chat lines and IMs it sends.
  // Linden Lab allows at most 5,000 a day for all of one person's bots.
  "DailyMessageLimit": 500,
  "MessagesPerMinute": 10

  // Where the activity log goes. Defaults to %LOCALAPPDATA%\SecondSight\logs.
  // "ActivityLogDirectory": "C:\\SecondSight\\logs"
}
